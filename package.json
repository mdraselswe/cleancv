    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "immer": "^11.1.18",
    "lucide-react": "^1.33.0",
