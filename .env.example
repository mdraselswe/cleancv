# ── Accounts ────────────────────────────────────────────────────────────────
# Without these two the app still runs and the PDF download stays open; the
# sign-in pages say auth is not configured. In production they are required.

# Neon (or any Postgres). https://neon.tech -> project -> connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/cleancv?sslmode=require"

# Signs session cookies and the emailed tokens. 32+ characters.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The app's own origin. Leave unset locally and on Vercel — it is derived from
# localhost and from VERCEL_PROJECT_PRODUCTION_URL. Set it for a custom domain.
# BETTER_AUTH_URL="https://cv.example.com"

# ── Google sign-in (optional) ───────────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: <origin>/api/auth/callback/google
# Without these the Google button is not rendered at all.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (optional in development, required in production) ─────────────────
# resend.com -> API keys. Without a key, verification and reset links are
# printed to the server log instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="CleanCV <onboarding@resend.dev>"

# Private /admin dashboard. Must match a verified CleanCV account.
ADMIN_EMAIL=""

# ── Smart import (optional, unrelated to accounts) ──────────────────────────
# Configured in the app's UI, not here.
